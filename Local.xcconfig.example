// Copy this file to Local.xcconfig (git-ignored) and fill in your values.
// Local.xcconfig is the ONLY place the signing team is set, so a work or other
// team on the same Apple ID can never be picked by accident.

// 10-character Team ID of your free "Personal Team".
// Xcode > Settings > Accounts > your Apple ID > "<Your Name> (Personal Team)".
DEVELOPMENT_TEAM = XXXXXXXXXX

// Bundle ID prefix, unique to you (App IDs are registered to your team, so you can't reuse
// someone else's). Targets append ".greekink" and ".greekink.keyboard"; the App Group becomes
// "group.<prefix>.greekink".
BUNDLE_ID_PREFIX = com.example.yourname
